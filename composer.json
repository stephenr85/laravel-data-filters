{
    "name": "rushing/laravel-data-filters",
    "description": "Host-agnostic filtering spine for Laravel. Declare a resource's filterable surface once on a Spatie Data class; derive a spatie/laravel-query-builder query, an x-filter JSON-Schema keyword for UI parity (via laravel-data-schemas), and persisted saved filters from that single declaration.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "rushing/php-popcorn": "dev-main",
        "schemastud/laravel-data-schemas": "dev-main",
        "spatie/laravel-data": "^4.0",
        "spatie/laravel-package-tools": "^1.16",
        "spatie/laravel-query-builder": "^7.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "repositories": {
        "laravel-data-schemas": {
            "type": "git",
            "url": "https://github.com/schemastud/laravel-data-schemas.git"
        },
        "php-json-ns": {
            "type": "git",
            "url": "https://github.com/schemastud/php-json-ns.git"
        },
        "laravel-popcorn": {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-popcorn.git"
        },
        "php-popcorn": {
            "type": "git",
            "url": "https://github.com/stephenr85/php-popcorn.git"
        },
        "laravel-pipeline-registry": {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-pipeline-registry.git"
        }
    },
    "autoload": {
        "psr-4": {
            "Rushing\\DataFilters\\": "src/",
            "Rushing\\DataFilters\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rushing\\DataFilters\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Rushing\\DataFilters\\ServiceProvider"
            ]
        },
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "pint": "@php -d memory_limit=512M vendor/bin/pint"
    }
}
